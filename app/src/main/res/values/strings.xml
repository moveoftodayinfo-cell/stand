    <!-- Accessibility Consent Dialog (CRITICAL for Google Play compliance) -->
    <string name="accessibility_consent_title">App Control Permission Required</string>
    <string name="accessibility_consent_desc">rebon requires Accessibility Service permission to provide the app blocking feature.\n\n[Why is this permission necessary?]\nAndroid does not provide any other API that allows apps to detect which app is currently running in the foreground. Accessibility Service is the ONLY way to implement this core functionality.\n\n[How is this permission used?]\nrebon ONLY monitors which app is currently displayed on screen. When you open an app that you selected to block, and your daily step goal is not yet achieved, rebon displays a blocking screen.\n\n[Data Privacy]\n• NO personal data is collected\n• NO data is stored on external servers\n• NO data is shared with third parties\n• All data remains on your device only\n\nYou can disable this permission anytime in Settings > Accessibility > rebon.</string>
    <string name="accessibility_consent_feature_title">Technical Details:</string>
    <string name="accessibility_consent_feature_1">• Monitors foreground app package name only</string>
    <string name="accessibility_consent_feature_2">• Compares with your blocked app list</string>
    <string name="accessibility_consent_feature_3">• Shows blocking screen if goal not achieved</string>
    <string name="accessibility_consent_feature_4">• Automatically unlocks when goal is reached</string>
    <string name="accessibility_consent_agree">I Agree</string>
    <string name="accessibility_consent_decline">I Decline</string>
    <string name="accessibility_declined_title">Cannot Use App</string>
    <string name="accessibility_declined_message">Accessibility Service is required for rebon\'s core app blocking feature.\n\nThis is the only way Android allows apps to detect foreground apps. Without this permission, the app blocking feature cannot work.\n\nIf you have privacy concerns, please note that rebon does NOT collect, store, or transmit any personal data.</string>
    <string name="accessibility_declined_understand">OK</string>
