<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.WalkorWait" parent="Theme.AppCompat.Light.NoActionBar" />

    <!-- Sudoku Widget Styles -->
    <style name="SudokuCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#222222</item>
        <item name="android:textSize">18dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/sudoku_cell_background</item>
    </style>

    <style name="SudokuNumber">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#222222</item>
        <item name="android:textSize">16dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">6dp</item>
        <item name="android:background">@drawable/sudoku_number_background</item>
    </style>
</resources>