<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="8dp"
    android:orientation="horizontal">

    <!-- 펫 아이콘 (Now 슬롯) -->
    <LinearLayout
        android:id="@+id/weather_slot_0"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:clipToPadding="false"
        android:clipChildren="false">

        <!-- 아이콘+온도 그룹 (온도에 따라 이동) - weight=1로 남은 공간 채움 -->
        <LinearLayout
            android:id="@+id/weather_group_0"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal|bottom"
            android:clipToPadding="false"
            android:clipChildren="false">

            <ImageView
                android:id="@+id/widget_pet_icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pet_placeholder"
                android:contentDescription="pet" />

            <TextView
                android:id="@+id/weather_temp_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="23°"
                android:textColor="#222222"
                android:textSize="13dp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/weather_time_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Now"
            android:textColor="#888888"
            android:textSize="11dp" />
    </LinearLayout>

    <!-- Slot 1 -->
    <LinearLayout
        android:id="@+id/weather_slot_1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <LinearLayout
            android:id="@+id/weather_group_1"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal|bottom">

            <TextView
                android:id="@+id/weather_icon_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀&#xFE0E;"
                android:textColor="#888888"
                android:textSize="24dp" />

            <TextView
                android:id="@+id/weather_temp_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="21°"
                android:textColor="#222222"
                android:textSize="13dp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/weather_time_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3AM"
            android:textColor="#888888"
            android:textSize="11dp" />
    </LinearLayout>

    <!-- Slot 2 -->
    <LinearLayout
        android:id="@+id/weather_slot_2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <LinearLayout
            android:id="@+id/weather_group_2"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal|bottom">

            <TextView
                android:id="@+id/weather_icon_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☁&#xFE0E;"
                android:textColor="#888888"
                android:textSize="24dp" />

            <TextView
                android:id="@+id/weather_temp_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="19°"
                android:textColor="#222222"
                android:textSize="13dp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/weather_time_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6AM"
            android:textColor="#888888"
            android:textSize="11dp" />
    </LinearLayout>

    <!-- Slot 3 -->
    <LinearLayout
        android:id="@+id/weather_slot_3"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <LinearLayout
            android:id="@+id/weather_group_3"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal|bottom">

            <TextView
                android:id="@+id/weather_icon_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☂&#xFE0E;"
                android:textColor="#888888"
                android:textSize="24dp" />

            <TextView
                android:id="@+id/weather_temp_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18°"
                android:textColor="#222222"
                android:textSize="13dp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/weather_time_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="9AM"
            android:textColor="#888888"
            android:textSize="11dp" />
    </LinearLayout>

    <!-- 중앙: 앱 로고 + rebon + location -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <LinearLayout
            android:id="@+id/weather_group_center"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal|bottom">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@mipmap/ic_launcher"
                android:scaleType="fitCenter"
                android:contentDescription="app icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="rebon"
                android:textColor="#222222"
                android:textSize="13dp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seoul"
            android:textColor="#666666"
            android:textSize="11dp" />
    </LinearLayout>

    <!-- Slot 4 -->
    <LinearLayout
        android:id="@+id/weather_slot_4"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <LinearLayout
            android:id="@+id/weather_group_4"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal|bottom">

            <TextView
                android:id="@+id/weather_icon_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀&#xFE0E;"
                android:textColor="#888888"
                android:textSize="24dp" />

            <TextView
                android:id="@+id/weather_temp_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="22°"
                android:textColor="#222222"
                android:textSize="13dp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/weather_time_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12PM"
            android:textColor="#888888"
            android:textSize="11dp" />
    </LinearLayout>

    <!-- Slot 5 -->
    <LinearLayout
        android:id="@+id/weather_slot_5"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <LinearLayout
            android:id="@+id/weather_group_5"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal|bottom">

            <TextView
                android:id="@+id/weather_icon_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀&#xFE0E;"
                android:textColor="#888888"
                android:textSize="24dp" />

            <TextView
                android:id="@+id/weather_temp_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25°"
                android:textColor="#222222"
                android:textSize="13dp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/weather_time_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3PM"
            android:textColor="#888888"
            android:textSize="11dp" />
    </LinearLayout>

    <!-- Slot 6 -->
    <LinearLayout
        android:id="@+id/weather_slot_6"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <LinearLayout
            android:id="@+id/weather_group_6"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal|bottom">

            <TextView
                android:id="@+id/weather_icon_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☾&#xFE0E;"
                android:textColor="#888888"
                android:textSize="24dp" />

            <TextView
                android:id="@+id/weather_temp_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20°"
                android:textColor="#222222"
                android:textSize="13dp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/weather_time_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6PM"
            android:textColor="#888888"
            android:textSize="11dp" />
    </LinearLayout>

</LinearLayout>
