<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_2x2"
    android:padding="10dp"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <!-- Pet Area with Emotion -->
        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp">

            <ImageView
                android:id="@+id/widget_pet_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|center_horizontal"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pet_placeholder"
                android:contentDescription="pet" />

            <TextView
                android:id="@+id/widget_emotion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:text="♪"
                android:textColor="#222222"
                android:textSize="8sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Sudoku"
            android:textColor="#222222"
            android:textSize="14sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Status/Message -->
        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#222222"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <!-- New Puzzle -->
        <ImageView
            android:id="@+id/widget_new_puzzle"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_refresh"
            android:contentDescription="new puzzle"
            android:padding="2dp" />
    </LinearLayout>

    <!-- 4x4 Sudoku Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/widget_sudoku_grid_background"
        android:padding="2dp">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView android:id="@+id/cell_00" style="@style/SudokuCell" android:text="1" />
            <TextView android:id="@+id/cell_01" style="@style/SudokuCell" />
            <FrameLayout android:layout_width="1dp" android:layout_height="match_parent" android:background="#222222" />
            <TextView android:id="@+id/cell_02" style="@style/SudokuCell" android:text="3" />
            <TextView android:id="@+id/cell_03" style="@style/SudokuCell" />
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView android:id="@+id/cell_10" style="@style/SudokuCell" />
            <TextView android:id="@+id/cell_11" style="@style/SudokuCell" android:text="4" />
            <FrameLayout android:layout_width="1dp" android:layout_height="match_parent" android:background="#222222" />
            <TextView android:id="@+id/cell_12" style="@style/SudokuCell" />
            <TextView android:id="@+id/cell_13" style="@style/SudokuCell" android:text="2" />
        </LinearLayout>

        <!-- Horizontal divider -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#222222" />

        <!-- Row 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView android:id="@+id/cell_20" style="@style/SudokuCell" android:text="2" />
            <TextView android:id="@+id/cell_21" style="@style/SudokuCell" />
            <FrameLayout android:layout_width="1dp" android:layout_height="match_parent" android:background="#222222" />
            <TextView android:id="@+id/cell_22" style="@style/SudokuCell" android:text="4" />
            <TextView android:id="@+id/cell_23" style="@style/SudokuCell" />
        </LinearLayout>

        <!-- Row 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView android:id="@+id/cell_30" style="@style/SudokuCell" />
            <TextView android:id="@+id/cell_31" style="@style/SudokuCell" android:text="1" />
            <FrameLayout android:layout_width="1dp" android:layout_height="match_parent" android:background="#222222" />
            <TextView android:id="@+id/cell_32" style="@style/SudokuCell" />
            <TextView android:id="@+id/cell_33" style="@style/SudokuCell" android:text="3" />
        </LinearLayout>
    </LinearLayout>

    <!-- Number Input Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:gravity="center">

        <TextView android:id="@+id/num_1" style="@style/SudokuNumber" android:text="1" />
        <TextView android:id="@+id/num_2" style="@style/SudokuNumber" android:text="2" />
        <TextView android:id="@+id/num_3" style="@style/SudokuNumber" android:text="3" />
        <TextView android:id="@+id/num_4" style="@style/SudokuNumber" android:text="4" />
    </LinearLayout>

</LinearLayout>
