<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="8dp"
    android:orientation="horizontal">

    <!-- 왼쪽: 한국어 문장만 -->
    <LinearLayout
        android:id="@+id/left_area"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/korean_sentence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="안녕하세요"
            android:textColor="#222222"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="2" />

    </LinearLayout>

    <!-- 가운데 실선 -->
    <ImageView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#DDDDDD"
        android:contentDescription="divider" />

    <!-- 오른쪽: tap!/펫/rebon 또는 정답 -->
    <LinearLayout
        android:id="@+id/right_area"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="8dp">

        <!-- 언어 코드 (EN, 日, 中 등) -->
        <TextView
            android:id="@+id/lang_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EN"
            android:textColor="#555555"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- 펫 아이콘 -->
        <ImageView
            android:id="@+id/pet_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_pet_placeholder" />

        <!-- rebon (초기에만) -->
        <TextView
            android:id="@+id/rebon_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="rebon"
            android:textColor="#888888"
            android:textSize="9sp" />

        <!-- 정답 텍스트 -->
        <TextView
            android:id="@+id/answer_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#555555"
            android:textSize="11sp"
            android:gravity="center"
            android:maxLines="2" />

    </LinearLayout>

</LinearLayout>
