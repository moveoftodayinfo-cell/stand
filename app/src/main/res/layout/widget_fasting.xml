<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_fasting_border"
    android:padding="8dp">

    <!-- 왼쪽: 타이머 영역 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/challenge_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="간헐적 단식"
            android:textSize="10sp"
            android:textColor="#999999"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/timer_elapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00 경과"
            android:textSize="16sp"
            android:textColor="#333333"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/timer_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="16:00 남음"
            android:textSize="13sp"
            android:textColor="#666666"
            android:fontFamily="sans-serif"
            android:layout_marginBottom="8dp" />

        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:progress="0"
            android:max="100"
            android:progressTint="#333333"
            android:progressBackgroundTint="#EEEEEE" />
    </LinearLayout>

    <!-- 구분선 (ImageView로 구현) -->
    <ImageView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#DDDDDD"
        android:contentDescription="divider" />

    <!-- 오른쪽: 펫 메시지 영역 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="6dp">

        <ImageView
            android:id="@+id/pet_image"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_pet_placeholder"
            android:contentDescription="pet"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/pet_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="소화 중!\n혈당 안정화"
            android:textSize="10sp"
            android:textColor="#333333"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingExtra="0dp" />
    </LinearLayout>
</LinearLayout>
