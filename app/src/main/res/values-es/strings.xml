    <!-- Accessibility Consent Dialog (CRITICAL for Google Play compliance) -->
    <string name="accessibility_consent_title">Consentimiento de Permiso de Control</string>
    <string name="accessibility_consent_desc">rebon requiere el permiso del Servicio de Accesibilidad para proporcionar la función de bloqueo de apps.\n\n[¿Por qué se necesita este permiso?]\nAndroid no proporciona otra API para detectar qué app está actualmente en primer plano. El Servicio de Accesibilidad es la ÚNICA forma de implementar esta funcionalidad principal.\n\n[¿Cómo se usa este permiso?]\nrebon SOLO monitorea qué app se muestra actualmente en pantalla. Cuando abres una app que seleccionaste para bloquear, y tu meta diaria de pasos aún no se ha logrado, rebon muestra una pantalla de bloqueo.\n\n[Privacidad de Datos]\n• NO se recopilan datos personales\n• NO se almacenan datos en servidores externos\n• NO se comparten datos con terceros\n• Todos los datos permanecen solo en tu dispositivo\n\nPuedes desactivar este permiso en cualquier momento en Ajustes > Accesibilidad > rebon.</string>
    <string name="accessibility_consent_feature_title">Detalles Técnicos:</string>
    <string name="accessibility_consent_feature_1">• Solo monitorea el nombre del paquete de la app en primer plano</string>
    <string name="accessibility_consent_feature_2">• Compara con tu lista de apps bloqueadas</string>
    <string name="accessibility_consent_feature_3">• Muestra pantalla de bloqueo si la meta no se logra</string>
    <string name="accessibility_consent_feature_4">• Desbloquea automáticamente al lograr la meta</string>
    <string name="accessibility_consent_agree">Acepto</string>
    <string name="accessibility_consent_decline">No acepto</string>
    <string name="accessibility_declined_title">No Se Puede Usar la App</string>
    <string name="accessibility_declined_message">El Servicio de Accesibilidad es necesario para la función principal de bloqueo de apps de rebon.\n\nEsta es la única forma en que Android permite detectar apps en primer plano. Sin este permiso, la función de bloqueo no puede funcionar.\n\nSi te preocupa la privacidad, ten en cuenta que rebon NO recopila, almacena ni transmite ningún dato personal.</string>
    <string name="accessibility_declined_understand">OK</string>
