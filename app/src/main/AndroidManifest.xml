<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 광고 ID (Firebase Analytics용) -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <uses-permission android:name="com.android.vending.BILLING" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-feature android:name="android.hardware.sensor.stepdetector" android:required="false" />

    <!-- 휴대폰만 지원, 태블릿 제외 -->
    <supports-screens
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="false"
        android:xlargeScreens="false"
        android:requiresSmallestWidthDp="0"
        android:compatibleWidthLimitDp="599" />

    <!-- 인터넷 (날씨 API) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 위치 (날씨 조회용) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Health Connect 권한 -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />

    <!-- Health Connect 앱 쿼리 -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <package android:name="com.sec.android.app.shealth" />
        <package android:name="com.google.android.apps.fitness" />
        <package android:name="com.garmin.android.apps.connectmobile" />

        <!-- 모든 런처 앱 조회 가능 -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <application
        android:name=".WalkorWaitApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WalkorWait"
        tools:targetApi="31">

        <!-- 광고 ID 수집 (Firebase Analytics용) -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="true" />
        <meta-data
            android:name="firebase_analytics_collection_deactivated"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.WalkorWait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Health Connect 권한 요청 결과 -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
            <!-- 친구 초대 딥링크 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="walkorwait" android:host="invite" />
            </intent-filter>
        </activity>

        <!-- Health Connect 권한 설정 화면 -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".AppBlockService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 기존 걸음수 위젯 (2x1) -->
        <receiver
            android:name=".StepWidgetProvider"
            android:exported="true"
            android:label="걸음수">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- 2x2 펫 위젯 -->
        <receiver
            android:name=".PetWidget2x2Provider"
            android:exported="true"
            android:label="펫 위젯">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_pet_2x2_info" />
        </receiver>

        <!-- 명언 위젯 -->
        <receiver
            android:name=".QuoteWidgetProvider"
            android:exported="true"
            android:label="오늘의 명언">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quote_info" />
        </receiver>

        <!-- 스도쿠 위젯 -->
        <receiver
            android:name=".SudokuWidgetProvider"
            android:exported="true"
            android:label="스도쿠">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_sudoku_info" />
        </receiver>

        <!-- 날씨 위젯 -->
        <receiver
            android:name=".WeatherWidgetProvider"
            android:exported="true"
            android:label="날씨">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_weather_info" />
        </receiver>

        <!-- 여행 회화 위젯 (영어) -->
        <receiver
            android:name=".TravelPhraseWidgetProvider"
            android:exported="true"
            android:label="여행 영어">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_travel_phrase_info" />
        </receiver>

        <!-- 여행 회화 위젯 (일본어) -->
        <receiver
            android:name=".TravelPhraseJapaneseWidgetProvider"
            android:exported="true"
            android:label="여행 일본어">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_travel_phrase_jp_info" />
        </receiver>

        <!-- 여행 회화 위젯 (중국어) -->
        <receiver
            android:name=".TravelPhraseChineseWidgetProvider"
            android:exported="true"
            android:label="여행 중국어">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_travel_phrase_cn_info" />
        </receiver>

        <!-- 한국어 학습 위젯 (외국인용) -->
        <receiver
            android:name=".TravelPhraseKoreanWidgetProvider"
            android:exported="true"
            android:label="Learn Korean">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_travel_phrase_kr_info" />
        </receiver>

        <!-- 간헐적 단식 위젯 -->
        <receiver
            android:name=".FastingWidgetProvider"
            android:exported="true"
            android:label="간헐적 단식">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_fasting_info" />
        </receiver>

        <!-- 자정 자동 리셋 (걸음수 + 위젯) -->
        <receiver
            android:name=".MidnightResetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.moveoftoday.walkorwait.MIDNIGHT_RESET" />
            </intent-filter>
        </receiver>

        <service
            android:name=".StepCounterService"
            android:foregroundServiceType="health" />

        <!-- FileProvider for image sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>